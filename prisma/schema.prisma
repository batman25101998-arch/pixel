generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

enum UserRole {
  USER
  ADMIN
  MODERATOR

  @@map("user_role")
}

enum HexStatus {
  AVAILABLE
  OWNED
  FOR_SALE
  LOCKED
  BANNED

  @@map("hex_status")
}

enum TerritoryStatus {
  ACTIVE
  ARCHIVED
  DISBANDED

  @@map("territory_status")
}

enum TerritoryLevel {
  VILLAGE
  CITY
  KINGDOM
  EMPIRE

  @@map("territory_level")
}

enum BadgeType {
  FOUNDER
  FIRST_HEX
  VILLAGE_OWNER
  CITY_BUILDER
  KINGDOM_FOUNDER
  COLLECTOR_100
  MARKETPLACE_SELLER

  @@map("badge_type")
}

enum MarketplaceStatus {
  ACTIVE
  SOLD
  CANCELED
  EXPIRED

  @@map("marketplace_status")
}

enum TransactionType {
  PRIMARY_PURCHASE
  RESALE_PURCHASE
  TERRITORY_TRANSFER
  ADMIN_ADJUSTMENT

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED

  @@map("transaction_status")
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED

  @@map("payment_status")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.Citext
  username          String    @unique @db.Citext
  displayName       String    @map("display_name") @db.VarChar(48)
  passwordHash      String?   @map("password_hash")
  avatarUrl         String?   @map("avatar_url")
  bio               String?   @db.VarChar(180)
  role              UserRole  @default(USER)
  founderNumber     Int?      @unique @map("founder_number")
  kingdomUnlockedAt DateTime? @map("kingdom_unlocked_at") @db.Timestamptz(6)
  bannedAt          DateTime? @map("banned_at") @db.Timestamptz(6)
  banReason         String?   @map("ban_reason") @db.VarChar(240)
  emailVerified     DateTime? @map("email_verified") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedHexes   Hex[]                @relation("HexOwner")
  territories  Territory[]
  sessions     Session[]
  accounts     Account[]
  buyerDeals   Transaction[]        @relation("TransactionBuyer")
  sellerDeals  Transaction[]        @relation("TransactionSeller")
  payments     Payment[]
  listings     MarketplaceListing[]
  badges       Badge[]
  adminActions AdminAuditLog[]      @relation("AdminActor")

  @@index([role, createdAt])
  @@index([displayName])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(32)
  provider          String  @db.VarChar(64)
  providerAccountId String  @map("provider_account_id") @db.VarChar(191)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Hex {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  h3Index      String    @unique @map("h3_index") @db.VarChar(32)
  resolution   Int       @default(5) @db.SmallInt
  q            Int
  r            Int
  latitude     Float?
  longitude    Float?
  countryCode  String?   @map("country_code") @db.Char(2)
  ownerId      String    @map("owner_id") @db.Uuid
  territoryId  String?   @map("territory_id") @db.Uuid
  purchaseDate DateTime  @default(now()) @map("purchase_date") @db.Timestamptz(6)
  priceCents   BigInt    @default(100) @map("price_cents")
  message      String    @default("") @db.VarChar(240)
  title        String    @default("") @db.VarChar(80)
  avatarUrl    String?   @map("avatar_url")
  imageUrl     String?   @map("image_url")
  link         String?
  status       HexStatus @default(OWNED)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User                 @relation("HexOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  territory    Territory?           @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  listings     MarketplaceListing[]
  transactions Transaction[]

  @@index([ownerId, purchaseDate(sort: Desc)])
  @@index([ownerId, countryCode])
  @@index([territoryId])
  @@index([resolution, q, r])
  @@index([latitude, longitude])
  @@index([status, updatedAt])
  @@map("hexes")
}

model Territory {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String          @map("owner_id") @db.Uuid
  name           String          @db.VarChar(80)
  slug           String          @unique @db.VarChar(96)
  flag           String          @default("🏳️") @db.VarChar(16)
  description    String          @default("") @db.VarChar(240)
  bannerImageUrl String?         @map("banner_image_url")
  flagUrl        String?         @map("flag_url")
  color          String          @default("#22c55e") @db.VarChar(16)
  level          TerritoryLevel  @default(VILLAGE)
  statistics     Json            @default("{}")
  status         TerritoryStatus @default(ACTIVE)
  hexCount       Int             @default(0) @map("hex_count")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hexes Hex[]

  @@index([ownerId, status])
  @@index([level, hexCount(sort: Desc)])
  @@index([status, hexCount(sort: Desc)])
  @@map("territories")
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hexId            String            @map("hex_id") @db.Uuid
  buyerId          String            @map("buyer_id") @db.Uuid
  sellerId         String?           @map("seller_id") @db.Uuid
  marketplaceId    String?           @map("marketplace_id") @db.Uuid
  paymentId        String?           @unique @map("payment_id") @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  /// Transaction amount in minor currency units (for example, cents).
  amount           BigInt
  platformFeeCents BigInt            @default(0) @map("platform_fee_cents")
  currency         String            @default("usd") @db.Char(3)
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)

  hex         Hex                 @relation(fields: [hexId], references: [id], onDelete: Restrict)
  buyer       User                @relation("TransactionBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller      User?               @relation("TransactionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  marketplace MarketplaceListing? @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([hexId, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([type, createdAt(sort: Desc)])
  @@map("transactions")
}

model MarketplaceListing {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hexId     String            @map("hex_id") @db.Uuid
  sellerId  String            @map("seller_id") @db.Uuid
  status    MarketplaceStatus @default(ACTIVE)
  /// Listing price in minor currency units (for example, cents).
  price     BigInt
  active    Boolean           @default(true)
  currency  String            @default("usd") @db.Char(3)
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  hex          Hex           @relation(fields: [hexId], references: [id], onDelete: Cascade)
  seller       User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([active, price])
  @@index([status, price])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("marketplace")
}

model Badge {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      BadgeType
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("badges")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              String        @default("stripe") @db.VarChar(32)
  providerCheckoutId    String?       @unique @map("provider_checkout_id")
  providerPaymentIntent String?       @unique @map("provider_payment_intent")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  amountCents           BigInt        @map("amount_cents")
  currency              String        @default("usd") @db.Char(3)
  metadata              Json          @default("{}")
  rawEvent              Json?         @map("raw_event")
  providerRefundId      String?       @unique @map("provider_refund_id")
  refundedAt            DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([provider, status, createdAt])
  @@map("payments")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token")
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  expires      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id") @db.VarChar(191)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User @relation("AdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}
